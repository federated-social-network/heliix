# ── PostgreSQL ────────────────────────────────────────────
POSTGRES_USER=heliix
POSTGRES_PASSWORD=heliix_dev_password
POSTGRES_DB=heliix

# ── Backend ───────────────────────────────────────────────
INSTANCE_NAME=heliix-local
DATABASE_URL=postgresql://heliix:heliix_dev_password@db:5432/heliix
SECRET_KEY=change-me-to-a-random-secret
ALGORITHM=HS256
BASE_URL=http://localhost:8000
PGSSLMODE=disable

# ── Email (optional for local dev) ────────────────────────
EMAIL_PROVIDER=gmail_oauth
FROM_EMAIL=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
